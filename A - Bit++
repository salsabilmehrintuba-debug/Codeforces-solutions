#include <stdio.h>
 
int main()
{
    int n;
    scanf("%d", &n);
 
    char s[10];
    int count = 0;
 
    for(int i = 0; i < n; i++)
    {
        scanf("%s", s);
 
        if(s[1] == '+')
        {
            count++;
        }
        else
        {
            count--;
        }
    }
 
    printf("%d\n", count);
 
    return 0;
}
